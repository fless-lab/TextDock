{
  "name": "textdock-ui",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src",
    "format": "prettier --write src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "twilio": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}

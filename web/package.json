{
  "name": "textdock-ui",
  "version": "0.8.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/icons.mjs && vite --host 127.0.0.1",
    "build": "node scripts/icons.mjs && tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src",
    "format": "prettier --write src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.58.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "twilio": "6.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
